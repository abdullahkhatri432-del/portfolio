                            "@types/react-dom":  "^19",
                            "dotenv":  "^17.4.2",
                            "eslint":  "^9",
                            "eslint-config-next":  "16.3.0",
                            "firebase-admin":  "^14.2.0",
                            "prettier":  "^3.9.6",
