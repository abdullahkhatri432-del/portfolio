    "engines":  {
                    "node":  "22.x"
                },
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint",
                    "lint:fix":  "eslint --fix",
                    "typecheck":  "tsc --noEmit",
                    "format":  "prettier --write \"src/**/*.{ts,tsx,css}\"",
                    "format:check":  "prettier --check \"src/**/*.{ts,tsx,css}\"",
                    "icons":  "node scripts/generate-favicon.mjs",
                    "verify":  "npm run typecheck \u0026\u0026 npm run lint \u0026\u0026 npm run build",
                    "seed:firestore":  "node scripts/seed-firestore.mjs",
                    "add:project":  "node scripts/add-project.mjs",
                    "list:projects":  "node scripts/list-projects.mjs",
                    "seed:demo":  "node scripts/seed-demo-data.mjs"
                },
    "dependencies":  {
