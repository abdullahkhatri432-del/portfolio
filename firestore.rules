rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Every project is a document in /projects.
    // The portfolio card itself is world-readable;
    // any application data beneath it is server-only.

    match /projects/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /projects/{slug}/{rest=**} {
      allow read, write: if false;
    }
  }
}
